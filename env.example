# Copy this file to .env and fill in your real key.
# .env is gitignored -- never commit real secrets.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Docker only (ignored when running on the host) ---
# Host port the containerized API is published on. The container always
# listens on 8000 internally; change this only if 8000 is already taken
# on the host (e.g. when running alongside the wazuh-dashboard stack).
RAG_PORT=8000

# Timezone for the container's audit-log timestamps. Set this to your
# host's zone (e.g. Europe/Istanbul) so timestamps written inside the
# container match ones written by a host-side `python main.py` run.
# Unset means the container runs on UTC. Ignored outside Docker.
TZ=UTC
